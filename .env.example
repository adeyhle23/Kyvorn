# Shopify Storefront API
# ------------------------------------------------------------------
# Leave these unset (or delete this file's copy at .env.local) to run
# the site fully on mock data — every page works with zero Shopify
# setup. Fill them in once you have a store and the UI switches to
# live data automatically, no code changes required.

# Your store's *.myshopify.com domain, no protocol, no trailing slash.
# Example: kyvorn-apparel.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API access token from a Headless or custom app
# (Settings > Apps and sales channels > Develop apps > your app >
# Storefront API). This is safe to expose to the client but is kept
# server-only here since cart mutations run through Next.js Server
# Actions.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version to target. Defaults to 2024-10 if unset.
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Handle of the Shopify collection to feature on the homepage.
# Defaults to "featured" if unset.
SHOPIFY_FEATURED_COLLECTION_HANDLE=featured

# Absolute site URL, used for canonical/OG metadata. Set this to your
# production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
# ------------------------------------------------------------------
# Backs the contact and newsletter forms (public insert-only — no
# login required, see supabase/migrations for the RLS policies).
# Project Settings > API in the Supabase dashboard.

# Project URL, e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (format: sb_publishable_...). Safe to expose to the
# client — table access is governed by Row Level Security, not by
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
